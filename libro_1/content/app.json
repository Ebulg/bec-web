,"ordering"],["to plan","planned","planned","planning"],["to plant","planted","planted","planting"],["to play","played","played","playing"],["to point","pointed","pointed","pointing"],["to practice","practiced","practiced","practicing"],["to push","pushed","pushed","pushing"],["to rain","rained","rained","raining"]]}]},{"src":[175],"blocks":[{"t":"h","text":"Regular Verbs"},{"t":"pairs","rows":[["*Inf. Present*","*Past Tense*","*Past Participle*","*Gerund*"],["to remember","remembered","remembered","remembering"],["to rent","rented","rented","renting"],["to repeat","repeated","repeated","repeating"],["to resist","resisted","resisted","resisting"],["to show","showed","showed","showing"],["to smoke","smoked","smoked","smoking"],["to start","started","started","starting"],["to stay","stayed","stayed","staying"],["to stop","stopped","stopped","stopping"],["to study","studied","studied","studying"],["to talk","talked","talked","talking"],["to travel","traveled","traveled","traveling"],["to try","tried","tried","trying"],["to turn","turned","turned","turning"],["to use","used","used","using"],["to visit","visited","visited","visiting"],["to wait","waited","waited","waiting"],["to walk","walked","walked","walking"],["to want","wanted","wanted","wanting"],["to wash","washed","washed","washing"],["to wish","wished","wished","wishing"],["to work","worked","worked","working"]]}]},{"src":[176],"blocks":[{"t":"h","text":"Pronunciation of Regular Verbs in Past Tense"},{"t":"p","text":"The past tense form of regular verbs is formed by adding *-ED* to the simple form of each verb. *-ED* is pronounced in three different forms: */ID/   /T/   /D/*"},{"t":"part","n":"1","title":"First Rule — Pronunciation /ID/"},{"t":"p","text":"When the last sound of the simple form of the verb is a /t/ or a /d/, -ed is pronounced /id/, as separate syllable."},{"t":"pairs","rows":[["*Repeat* — repeat-ed","*Sound* — sound-ed"],["*Need* — need-ed","*Rent* — rent-ed"],["*Invite* — invit-ed","*Offend* — offend-ed"],["*Divide* — divid-ed","*Correct* — correct-ed"]]},{"t":"part","n":"2","title":"Second Rule — Pronunciation /T/"},{"t":"p","text":"When the last sound of the simple form of the verb is a P, K, F, S, SS, X, SH or CH, the -ed is pronounced /t/. A separate syllable is not heard."},{"t":"pairs","rows":[["*Help* — help-ed","*Fix* — fix-ed"],["*Watch* — watch-ed","*Miss* — miss-ed"],["*Finish* — finish-ed","*Laugh* — laugh-ed"],["*Work* — work-ed","*Like* — like-ed"]]}]},{"src":[177],"blocks":[{"t":"h","text":"Pronunciation of Regular Verbs in Past Tense"},{"t":"part","n":"3","title":"Third Rule — Pronunciation /D/"},{"t":"p","text":"In all other cases, the -ed is pronounced like a soft /d/."},{"t":"pairs","rows":[["*Call* — call-ed","*Borrow* — borrow-ed"],["*Play* — play-ed","*Listen* — listen-ed"],["*Open* — open-ed","*Contain* — contain-ed"],["*Love* — love-ed","*Explain* — explain-ed"]]}]},{"src":[178],"blocks":[{"t":"chap","title":"Appendix 2","sub":"Irregular Verbs"},{"t":"pairs","rows":[["*Inf. Present*","*Past Tense*","*Past Participle*","*Gerund*"],["to be","was, were","been","being"],["to become","became","become","becoming"],["to begin","began","begun","beginning"],["to break","broke","broken","breaking"],["to bring","brought","brought","bringing"],["to build","built","built","building"],["to buy","bought","bought","buying"],["to come","came","come","coming"],["to cut","cut","cut","cutting"],["to do","did","done","doing"],["to dream","dreamt","dreamt","dreaming"],["to drink","drank","drunk","drinking"],["to drive","drove","driven","driving"],["to eat","ate","eaten","eating"],["to fall","fell","fallen","falling"],["to feel","felt","felt","feeling"],["to find","found","found","finding"],["to fly","flew","flown","flying"],["to forget","forgot","forgotten","forgetting"],["to get","got","gotten","getting"],["to give","gave","given","giving"],["to go","went","gone","going"]]}]},{"src":[179],"blocks":[{"t":"h","text":"Irregular Verbs"},{"t":"pairs","rows":