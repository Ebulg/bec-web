/**
 * Build script: writes index.html, menu.html, and updates the book HTML.
 * Run: node _build_files.mjs
 */
import { writeFileSync } from 'fs';

// ══════════════════════════════════════════════════════
// 1. index.html  —  Página de acceso con código
// ══════════════════════════════════════════════════════
const indexHtml = `<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bernal's English Course — Acceso</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:oklch(0.50 0.17 258);--navy:oklch(0.36 0.11 258);--warm:#d9d6cf;--white:#fffdf8;--ink:#1f1d1a}
html,body{height:100%;background:var(--warm);font-family:'Libre Franklin',Helvetica,Arial,sans-serif;color:var(--ink);overflow:hidden}
body::before{content:'';position:fixed;inset:0;background-image:radial-gradient(circle at 20% 30%,oklch(0.50 0.17 258/0.08) 0%,transparent 50%),radial-gradient(circle at 80% 70%,oklch(0.36 0.11 258/0.06) 0%,transparent 50%);pointer-events:none}
.page{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:24px;transition:opacity .6s ease,transform .6s ease}
.page.hidden{opacity:0;pointer-events:none;transform:translateY(-20px)}
.card{background:var(--white);border-radius:24px;box-shadow:0 2px 4px rgba(0,0,0,.06),0 20px 60px rgba(0,0,0,.14),0 0 0 1px rgba(0,0,0,.04);width:100%;max-width:480px;padding:52px 48px 44px;display:flex;flex-direction:column;align-items:center;animation:fadeUp .6s ease both}
.stars{display:flex;gap:8px;color:var(--blue);font-size:20px;margin-bottom:20px;letter-spacing:4px}
.brand-title{font-family:'Source Serif 4',serif;font-weight:900;font-size:32px;line-height:1.1;text-align:center;color:var(--ink);margin-bottom:6px}
.brand-sub{font-weight:600;font-size:11px;letter-spacing:.30em;text-transform:uppercase;color:var(--blue);margin-bottom:32px}
.divider{width:56px;height:3px;background:var(--blue);border-radius:2px;margin-bottom:32px}
.label{font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#8f887c;margin-bottom:10px;align-self:flex-start}
.input-wrap{position:relative;width:100%;margin-bottom:8px}
.input-wrap input{width:100%;padding:15px 50px 15px 20px;border:2px solid #e2ddd6;border-radius:14px;font-family:'Libre Franklin',sans-serif;font-size:15px;font-weight:500;color:var(--ink);background:#faf8f4;outline:none;transition:border-color .2s,box-shadow .2s;letter-spacing:.04em}
.input-wrap input::placeholder{color:#c4bfb7;font-weight:400;letter-spacing:0}
.input-wrap input:focus{border-color:var(--blue);box-shadow:0 0 0 4px oklch(0.50 0.17 258/.12)}
.input-wrap input.error{border-color:oklch(0.52 0.20 25);box-shadow:0 0 0 4px oklch(0.52 0.20 25/.10);animation:shake .35s ease}
.eye-btn{position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;padding:4px;color:#a09890;transition:color .2s;display:flex;align-items:center}
.eye-btn:hover{color:var(--blue)}
.error-msg{font-size:13px;font-weight:500;color:oklch(0.52 0.20 25);min-height:20px;margin-bottom:20px;align-self:flex-start;opacity:0;transition:opacity .25s}
.error-msg.show{opacity:1}
.btn-access{width:100%;padding:16px 24px;background:var(--blue);color:#fff;border:none;border-radius:14px;font-family:'Libre Franklin',sans-serif;font-size:15px;font-weight:700;letter-spacing:.06em;cursor:pointer;transition:background .2s,transform .15s,box-shadow .2s;display:flex;align-items:center;justify-content:center;gap:8px}
.btn-access:hover{background:var(--navy);box-shadow:0 6px 24px oklch(0.36 0.11 258/.35)}
.btn-access:active{transform:scale(.98)}
.foot-note{font-size:12px;color:#b8b0a6;text-align:center;margin-top:28px;line-height:1.5}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(5px)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
</style>
</head>
<body>
<div class="page" id="accessPage">
  <div class="card">
    <div class="stars">&#9733; &#9733; &#9733;</div>
    <div class="brand-title">Bernal's<br>English Course</div>
    <div class="brand-sub">Luis Bernal Gallardo</div>
    <div class="divider"></div>
    <div class="label">Codigo de Acceso</div>
    <div class="input-wrap">
      <input type="password" id="codeInput" placeholder="Ingresa tu codigo de acceso" autocomplete="off" spellcheck="false" maxlength="32">
      <button class="eye-btn" id="eyeBtn" type="button" title="Mostrar codigo">
        <svg id="eyeIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    </div>
    <div class="error-msg" id="errorMsg">Codigo incorrecto. Intenta de nuevo.</div>
    <button class="btn-access" id="accessBtn" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Acceder
    </button>
    <p class="foot-note">Ingresa el codigo de acceso que recibiste<br>para ver el contenido disponible.</p>
  </div>
</div>
<script>
(function(){
  var CODE='KA12SD123J238.123',SK='bec_access';
  var inp=document.getElementById('codeInput');
  var btn=document.getElementById('accessBtn');
  var err=document.getElementById('errorMsg');
  var eye=document.getElementById('eyeBtn');
  var icon=document.getElementById('eyeIcon');
  if(sessionStorage.getItem(SK)==='1'){window.location.replace('menu.html');}
  eye.addEventListener('click',function(){
    var is=inp.type==='password';
    inp.type=is?'text':'password';
    icon.innerHTML=is
      ?'<path d="M17.94 17.94A10 10 0 0 1 12 20c-7 0-11-8-11-8a18 18 0 0 1 5-6"/><path d="M9.9 4.24A9 9 0 0 1 12 4c7 0 11 8 11 8a18 18 0 0 1-2 3"/><line x1="1" y1="1" x2="23" y2="23"/>'
      :'<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  });
  function go(){
    var v=inp.value.trim();
    inp.classList.remove('error');err.classList.remove('show');
    if(v===CODE){
      sessionStorage.setItem(SK,'1');
      document.getElementById('accessPage').classList.add('hidden');
      setTimeout(function(){window.location.replace('menu.html');},400);
    }else{
      void inp.offsetWidth;
      inp.classList.add('error');err.classList.add('show');inp.select();
    }
  }
  btn.addEventListener('click',go);
  inp.addEventListener('keydown',function(e){if(e.key==='Enter')go();});
})();
</script>
</body>
</html>`;

// ══════════════════════════════════════════════════════
// 2. menu.html  —  Menú de libros disponibles
// ══════════════════════════════════════════════════════
const menuHtml = `<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bernal's English Course — Biblioteca</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:oklch(0.50 0.17 258);--navy:oklch(0.36 0.11 258);--warm:#d9d6cf;--warm2:#e8e4dc;--white:#fffdf8;--ink:#1f1d1a;--muted:#8f887c}
html,body{min-height:100%;background:var(--warm);font-family:'Libre Franklin',Helvetica,Arial,sans-serif;color:var(--ink)}
body::before{content:'';position:fixed;inset:0;background-image:radial-gradient(circle at 15% 25%,oklch(0.50 0.17 258/0.07) 0%,transparent 45%),radial-gradient(circle at 85% 75%,oklch(0.36 0.11 258/0.05) 0%,transparent 45%);pointer-events:none;z-index:0}
/* ── Header ── */
header{background:var(--white);border-bottom:1px solid rgba(0,0,0,.07);padding:0 40px;display:flex;align-items:center;justify-content:space-between;height:70px;position:sticky;top:0;z-index:100;box-shadow:0 1px 12px rgba(0,0,0,.06)}
.header-brand{display:flex;align-items:center;gap:14px}
.header-brand .logo-mark{width:36px;height:36px;background:var(--blue);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Source Serif 4',serif;font-weight:900;font-size:18px}
.header-brand h1{font-family:'Source Serif 4',serif;font-weight:700;font-size:18px;color:var(--ink)}
.header-brand span{font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.header-right{display:flex;align-items:center;gap:10px}
.btn-logout{display:flex;align-items:center;gap:7px;padding:9px 16px;border-radius:10px;border:1.5px solid #e2ddd6;background:none;font-family:'Libre Franklin',sans-serif;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;transition:all .2s;letter-spacing:.04em;text-transform:uppercase}
.btn-logout:hover{background:#f0ece4;border-color:#cdc6bb;color:var(--ink)}
/* ── Main ── */
main{position:relative;z-index:1;padding:60px 40px 80px;max-width:1200px;margin:0 auto}
.section-kicker{font-size:11px;font-weight:700;letter-spacing:.25em;text-transform:uppercase;color:var(--blue);margin-bottom:10px}
.section-title{font-family:'Source Serif 4',serif;font-weight:900;font-size:40px;color:var(--ink);margin-bottom:10px;line-height:1.1}
.section-sub{font-size:15px;color:var(--muted);margin-bottom:52px;line-height:1.5;max-width:520px}
/* ── Grid ── */
.books-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:28px}
/* ── Book Card ── */
.book-card{background:var(--white);border-radius:20px;box-shadow:0 2px 6px rgba(0,0,0,.05),0 8px 30px rgba(0,0,0,.08);overflow:hidden;display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s;text-decoration:none;color:inherit;position:relative}
.book-card:hover{transform:translateY(-6px);box-shadow:0 4px 12px rgba(0,0,0,.07),0 20px 50px rgba(0,0,0,.14)}
.book-card.disabled{opacity:.55;cursor:not-allowed;pointer-events:none}
.book-cover{width:100%;height:200px;background:oklch(0.60 0.20 27);position:relative;display:flex;flex-direction:column;justify-content:flex-end;padding:20px;overflow:hidden}
.book-cover::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,oklch(0.58 0.21 27) 0%,oklch(0.48 0.18 18) 100%)}
.cover-stars{position:absolute;top:0;left:0;bottom:60px;width:46px;display:flex;flex-direction:column;justify-content:space-around;align-items:center;color:rgba(255,255,255,.8);font-size:14px;background:oklch(0.56 0.20 27);z-index:1}
.cover-main{position:relative;z-index:1;padding-left:54px}
.cover-main .book-number{font:800 11px 'Libre Franklin',sans-serif;letter-spacing:.28em;text-transform:uppercase;color:rgba(255,255,255,.8);margin-bottom:4px}
.cover-main .book-name{font-family:'Source Serif 4',serif;font-weight:900;font-size:22px;color:#fff;line-height:1.1}
.badge-available{position:absolute;top:14px;right:14px;z-index:2;background:oklch(0.55 0.18 155);color:#fff;font:700 10px 'Libre Franklin',sans-serif;letter-spacing:.2em;text-transform:uppercase;padding:4px 10px;border-radius:20px}
.badge-soon{position:absolute;top:14px;right:14px;z-index:2;background:rgba(0,0,0,.35);color:rgba(255,255,255,.7);font:700 10px 'Libre Franklin',sans-serif;letter-spacing:.2em;text-transform:uppercase;padding:4px 10px;border-radius:20px}
.book-body{padding:24px 24px 20px;flex:1;display:flex;flex-direction:column;gap:10px}
.book-body h3{font-family:'Source Serif 4',serif;font-weight:700;font-size:18px;color:var(--ink)}
.book-body p{font-size:13.5px;line-height:1.55;color:var(--muted);flex:1}
.book-meta{display:flex;align-items:center;gap:14px;padding-top:10px;border-top:1px solid #f0ece4}
.meta-pill{display:flex;align-items:center;gap:5px;font-size:12px;font-weight:600;color:var(--muted)}
.meta-pill svg{flex:none;opacity:.7}
.book-cta{padding:0 24px 22px}
.btn-open{width:100%;padding:13px 20px;background:var(--blue);color:#fff;border:none;border-radius:12px;font-family:'Libre Franklin',sans-serif;font-size:14px;font-weight:700;letter-spacing:.06em;cursor:pointer;transition:background .2s,box-shadow .2s;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none}
.btn-open:hover{background:var(--navy);box-shadow:0 4px 16px oklch(0.36 0.11 258/.3)}
/* ── Footer ── */
footer{text-align:center;padding:40px 20px 60px;font-size:12px;color:#b8b0a6;line-height:1.7;position:relative;z-index:1}
/* ── Animations ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.books-grid .book-card{animation:fadeUp .5s ease both}
.books-grid .book-card:nth-child(1){animation-delay:.05s}
.books-grid .book-card:nth-child(2){animation-delay:.12s}
.books-grid .book-card:nth-child(3){animation-delay:.19s}
</style>
</head>
<body>
<header>
  <div class="header-brand">
    <div class="logo-mark">B</div>
    <div>
      <h1>Bernal's English Course</h1>
      <span>Biblioteca de Libros</span>
    </div>
  </div>
  <div class="header-right">
    <button class="btn-logout" id="logoutBtn" type="button">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Salir
    </button>
  </div>
</header>

<main>
  <div class="section-kicker">Libros Disponibles</div>
  <div class="section-title">Tu Biblioteca</div>
  <div class="section-sub">Selecciona un libro para comenzar a estudiar. Todos los libros incluyen ilustraciones originales vectorizadas y ejercicios interactivos.</div>

  <div class="books-grid">

    <!-- Libro 1 — DISPONIBLE -->
    <div class="book-card">
      <div class="book-cover">
        <div class="cover-stars">&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <div class="cover-main">
          <div class="book-number">Primer Libro</div>
          <div class="book-name">Bernal's English Course</div>
        </div>
        <span class="badge-available">Disponible</span>
      </div>
      <div class="book-body">
        <h3>First Book</h3>
        <p>30 lecciones desde vocabulario basico hasta gramatica avanzada. Incluye imagenes vectoriales, ejercicios de escritura y apendice de verbos.</p>
        <div class="book-meta">
          <div class="meta-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            204 paginas
          </div>
          <div class="meta-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            30 lecciones
          </div>
          <div class="meta-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            235 ilustraciones
          </div>
        </div>
      </div>
      <div class="book-cta">
        <a class="btn-open" href="Bernal's English Course.dc.html">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Abrir Libro
        </a>
      </div>
    </div>

    <!-- Libro 2 — PROXIMO -->
    <div class="book-card disabled">
      <div class="book-cover" style="background:oklch(0.45 0.14 258)">
        <div class="cover-stars" style="background:oklch(0.42 0.13 258)">&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <div class="cover-main">
          <div class="book-number">Segundo Libro</div>
          <div class="book-name">Bernal's English Course</div>
        </div>
        <span class="badge-soon">Proximo</span>
      </div>
      <div class="book-body">
        <h3>Second Book</h3>
        <p>Continuacion del metodo Bernal con gramatica intermedia, tiempos verbales compuestos y vocabulario especializado.</p>
        <div class="book-meta">
          <div class="meta-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            En preparacion
          </div>
        </div>
      </div>
      <div class="book-cta">
        <button class="btn-open" style="background:#b8b0a6;cursor:not-allowed" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Proximamente
        </button>
      </div>
    </div>

    <!-- Libro 3 — PROXIMO -->
    <div class="book-card disabled">
      <div class="book-cover" style="background:oklch(0.40 0.10 155)">
        <div class="cover-stars" style="background:oklch(0.37 0.09 155)">&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <div class="cover-main">
          <div class="book-number">Tercer Libro</div>
          <div class="book-name">Bernal's English Course</div>
        </div>
        <span class="badge-soon">Proximo</span>
      </div>
      <div class="book-body">
        <h3>Third Book</h3>
        <p>Nivel avanzado con conversacion fluida, redaccion formal e informal, y preparacion para examenes internacionales.</p>
        <div class="book-meta">
          <div class="meta-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            En preparacion
          </div>
        </div>
      </div>
      <div class="book-cta">
        <button class="btn-open" style="background:#b8b0a6;cursor:not-allowed" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Proximamente
        </button>
      </div>
    </div>

  </div>
</main>

<footer>
  &copy; Luis Bernal Gallardo &mdash; Bernal's English Course<br>
  Todos los derechos reservados.
</footer>

<script>
(function(){
  // Guard: redirect to login if not authenticated
  if(sessionStorage.getItem('bec_access')!=='1'){
    window.location.replace('index.html');
    return;
  }
  document.getElementById('logoutBtn').addEventListener('click',function(){
    sessionStorage.removeItem('bec_access');
    window.location.replace('index.html');
  });
  // Guard all book links
  document.querySelectorAll('.btn-open:not([disabled])').forEach(function(a){
    a.addEventListener('click',function(e){
      if(sessionStorage.getItem('bec_access')!=='1'){
        e.preventDefault();
        window.location.replace('index.html');
      }
    });
  });
})();
</script>
</body>
</html>`;

writeFileSync('index.html', indexHtml, 'utf8');
console.log('✓ index.html written:', indexHtml.length, 'bytes');

writeFileSync('menu.html', menuHtml, 'utf8');
console.log('✓ menu.html written:', menuHtml.length, 'bytes');
